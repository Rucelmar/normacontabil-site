---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner-grid">
    <form class="news" id="news-form" novalidate>
      <div class="hp-field" aria-hidden="true">
        <label>Empresa (não preencher)<input type="text" name="empresa_url" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="news__row">
        <input
          class="news__input"
          type="email"
          name="news-email"
          placeholder="Acompanhe as novidades"
          aria-label="Acompanhe as novidades"
        />
        <button type="submit" class="news__submit">Enviar</button>
      </div>
      <p class="news__status" role="status" aria-live="polite"></p>
    </form>

    <ul class="site-footer__contacts">
      <li><a href="mailto:contato@normacontabil.com">contato@normacontabil.com</a></li>
      <li><a href="tel:+5551983445863">+55 (51) 98344-5863</a></li>
    </ul>
  </div>

  <div class="container site-footer__legal">
    <span class="site-footer__copy-text">Norma Contábil, {year}.</span>
    <a class="footer-legal-link" href="/privacidade/">Política de Privacidade</a>
    <a class="footer-badge" href="https://safeweb.norton.com/report/show?url=www.normacontabil.com" target="_blank" rel="noopener nofollow" title="Norton Safe Web">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9.2" stroke="currentColor" stroke-width="1.8"/><path d="M7.8 12.4l2.8 2.8 5.6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Norton Safe Web</span>
    </a>
    <a class="footer-badge" href="https://transparencyreport.google.com/safe-browsing/search?url=normacontabil.com&hl=pt_BR" target="_blank" rel="noopener nofollow" title="Google Safe Browsing">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.6l7 2.5v5.3c0 4.5-2.98 8.06-7 9.4-4.02-1.34-7-4.9-7-9.4V5.1l7-2.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.9 12.1l2.1 2.1 4.1-4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Google Safe Browsing</span>
    </a>
  </div>
</footer>
