---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const banner = d.coverStyle === 'banner';

// Trecho do título em destaque (cor): só se aparecer no título.
const accentAt = d.titleAccent ? d.title.indexOf(d.titleAccent) : -1;
const titleHead = accentAt >= 0 ? d.title.slice(0, accentAt) : d.title;
const titleTail = accentAt >= 0 ? d.title.slice(accentAt + d.titleAccent!.length) : '';

// Sumário: as seções (h2) do corpo e, se houver, as perguntas frequentes.
const toc = d.toc
  ? [
      ...headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, text: h.text })),
      ...(d.faqs.length ? [{ href: '#faq-title', text: 'Perguntas frequentes' }] : []),
    ]
  : [];
const pad2 = (n: number) => String(n).padStart(2, '0');

const site = Astro.site ?? new URL('https://www.normacontabil.com');
const url = new URL(`/post/${post.id}/`, site).href;
const fmtDate = (dt: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(dt);

// Relacionados: só os que existem e não são o próprio post.
const related = d.related
  .map((slug) => posts.find((p) => p.id === slug))
  .filter((p): p is (typeof posts)[number] => !!p && p.id !== post.id);

const jsonLdExtra: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.excerpt,
    image: new URL(d.cover, site).href,
    datePublished: d.date.toISOString().slice(0, 10),
    mainEntityOfPage: url,
    author: d.author
      ? { '@type': 'Person', name: d.author }
      : { '@type': 'Organization', name: 'Norma Contábil' },
    publisher: { '@type': 'Organization', name: 'Norma Contábil', url: 'https://www.normacontabil.com' },
  },
];
if (d.faqs.length) {
  jsonLdExtra.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base
  title={`${d.title} | Norma Contábil`}
  description={d.excerpt.slice(0, 155)}
  active="blog"
  bodyClass="page--post"
  ogImage={d.cover}
  ogType="article"
  noindex={d.noindex}
  jsonLdExtra={jsonLdExtra}
>
  <article class={`post${d.toc ? ' post--toc' : ''}`}>
    <div class="post__panel">
      {banner ? (
        <header class="post__hero">
          <img class="post__hero-img" src={d.cover} alt="" width="1000" height="560" fetchpriority="high" />
          <div class="post__hero-in">
            {d.category && <p class="post__kicker">{d.category}</p>}
            <h1 class="post__title">{titleHead}{accentAt >= 0 && <span class="post__title-accent">{d.titleAccent}</span>}{titleTail}</h1>
            {d.subtitle && <p class="post__subtitle">{d.subtitle}</p>}
            <p class="post__hero-meta">
              {d.author && (
                <span class="post__byline">
                  {d.authorPhoto && <img class="post__author-photo" src={d.authorPhoto} alt="" width="40" height="40" loading="lazy" />}
                  <span>Por <strong>{d.author}</strong>{d.authorRole && <span class="post__role"> · {d.authorRole}</span>}</span>
                </span>
              )}
              <span>{fmtDate(d.date)} · {d.readingTime}</span>
            </p>
          </div>
        </header>
      ) : (
        <>
          <p class="post__meta">
            {fmtDate(d.date)} · {d.readingTime}{d.category && <> · <span class="post__category">{d.category}</span></>}
          </p>
          <h1 class="post__title">{titleHead}{accentAt >= 0 && <span class="post__title-accent">{d.titleAccent}</span>}{titleTail}</h1>
          {d.subtitle && <p class="post__subtitle">{d.subtitle}</p>}
          {d.author && (
            <p class="post__byline">
              {d.authorPhoto && <img class="post__author-photo" src={d.authorPhoto} alt="" width="40" height="40" loading="lazy" />}
              <span>Por <strong>{d.author}</strong>{d.authorRole && <span class="post__role"> · {d.authorRole}</span>}</span>
            </p>
          )}

          <figure class="post__cover">
            <img src={d.cover} alt="" width="1000" height="560" fetchpriority="high" />
          </figure>
        </>
      )}

      {d.summary && (
        <aside class="post__summary" aria-label="Resumo">
          <p class="post__summary-label">Resumo</p>
          <p>{d.summary}</p>
        </aside>
      )}

      {toc.length > 0 && (
        <nav class="post__toc" aria-labelledby="toc-title">
          <p class="post__toc-label" id="toc-title">Neste artigo</p>
          <ol>
            {toc.map((t, i) => (
              <li><a href={t.href}><span class="post__toc-n">{pad2(i + 1)}</span>{t.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="post__body">
        <Content />
      </div>

      {d.faqs.length > 0 && (
        <section class="post__faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Perguntas frequentes</h2>
          {d.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {related.length > 0 && (
        <nav class="post__related" aria-labelledby="related-title">
          <h2 id="related-title">Leia também</h2>
          <ul>
            {related.map((r) => (
              <li><a href={`/post/${r.id}/`}>{r.data.title}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>

  <Footer />
</Base>
